{
    "name": "aigram-desktop",
    "version": "2.6.0",
    "private": true,
    "description": "Aigram — Telegram с локальным ИИ",
    "author": "Aigram",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc",
        "check": "tsc --noEmit",
        "test": "npm run build && node --test tests/*.test.cjs",
        "start": "npm run build && electron .",
        "package": "npm run build && electron-builder --win portable --x64",
        "test:smoke": "node tests/smoke.cjs",
        "test:updater": "npm run build && node tests/updater-smoke.cjs && node tests/startup-updater-smoke.cjs && node tests/update-recovery-smoke.cjs && node tests/profile-migration-smoke.cjs",
        "test:media": "npm run build && node tests/media-viewer-smoke.cjs",
        "test:speech": "node tests/speech-smoke.cjs"
    },
    "devDependencies": {
        "electron": "44.7.2",
        "electron-builder": "26.15.3",
        "typescript": "5.9.3",
        "@types/node": "24.10.0"
    },
    "build": {
        "appId": "ru.aigram.desktop",
        "productName": "Aigram",
        "asar": true,
        "directories": {
            "output": "../complie",
            "buildResources": "assets"
        },
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../backend/build/install/backend/lib",
                "to": "backend/lib"
            },
            {
                "from": "../build/runtime",
                "to": "runtime"
            },
            {
                "from": "assets/aigram.png",
                "to": "aigram.png"
            },
            {
                "from": "assets/apply-update.ps1",
                "to": "apply-update.ps1"
            },
            {
                "from": "../NOTICE.md",
                "to": "legal/NOTICE.md"
            },
            {
                "from": "../docs/speech/licenses",
                "to": "legal/speech"
            },
            {
                "from": "../web/src/shared/assets/fonts/OFL.txt",
                "to": "legal/fonts/OFL.txt"
            }
        ],
        "win": {
            "icon": "assets/aigram.ico",
            "artifactName": "Aigram.exe",
            "signAndEditExecutable": true
        },
        "portable": {
            "requestExecutionLevel": "user",
            "unpackDirName": "aigram-2.6.0"
        }
    }
}
